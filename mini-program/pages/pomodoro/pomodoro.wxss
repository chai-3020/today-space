.page { padding-bottom: 40rpx; }
.mode-row { display: flex; gap: 12rpx; margin-bottom: 32rpx; }
.mode-item { flex: 1; text-align: center; padding: 16rpx 0; background: #f7f9fa; border-radius: 12rpx; font-size: 26rpx; color: #5c6b74; }
.mode-item.active { background: #e3f4ec; color: #0d9f6d; font-weight: 600; }
.ring-wrap { display: flex; justify-content: center; margin: 20rpx 0 32rpx; }
.ring { width: 400rpx; height: 400rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.3s; }
.ring-inner { width: 320rpx; height: 320rpx; background: #fff; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.timer { font-size: 80rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.timer-note { font-size: 26rpx; color: #5c6b74; margin-top: 8rpx; }
.pomo-actions { display: flex; gap: 20rpx; justify-content: center; }
.start-btn { width: 240rpx; background: #0d9f6d; color: #fff; border-radius: 999rpx; font-size: 32rpx; font-weight: 600; }
.start-btn.running { background: #e05f3a; }
.reset-btn { width: 160rpx; background: #fff; color: #5c6b74; border: 1px solid #dfe5e8; border-radius: 999rpx; font-size: 28rpx; }
.pomo-sessions { text-align: center; color: #5c6b74; font-size: 24rpx; margin-top: 28rpx; }

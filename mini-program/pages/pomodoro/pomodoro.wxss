.page { padding-bottom: 40rpx; }
.mode-row { display: flex; gap: 12rpx; margin-bottom: 32rpx; }
.mode-item { flex: 1; text-align: center; padding: 16rpx 0; background: var(--soft); border-radius: 12rpx; font-size: 26rpx; color: var(--muted); }
.mode-item.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
.ring-wrap { display: flex; justify-content: center; margin: 20rpx 0 32rpx; }
.ring { width: 400rpx; height: 400rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.3s; }
.ring-inner { width: 320rpx; height: 320rpx; background: var(--panel); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.timer { font-size: 80rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.timer-note { font-size: 26rpx; color: var(--muted); margin-top: 8rpx; }
.pomo-actions { display: flex; gap: 20rpx; justify-content: center; }
.start-btn { width: 240rpx; background: var(--accent); color: var(--panel); border-radius: 999rpx; font-size: 32rpx; font-weight: 600; }
.start-btn.running { background: var(--warm); }
.reset-btn { width: 160rpx; background: var(--panel); color: var(--muted); border: 1px solid var(--line); border-radius: 999rpx; font-size: 28rpx; }
.pomo-sessions { text-align: center; color: var(--muted); font-size: 24rpx; margin-top: 28rpx; }
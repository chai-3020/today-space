.page { padding-bottom: 40rpx; }
.overview-head { display: flex; justify-content: space-between; align-items: center; }
.greeting { font-size: 34rpx; font-weight: 700; }
.clock { font-size: 40rpx; font-weight: 700; color: #0d9f6d; font-variant-numeric: tabular-nums; }
.date-line { font-size: 24rpx; color: #5c6b74; margin: 8rpx 0 20rpx; }
.stat-row { display: flex; gap: 24rpx; }
.stat { flex: 1; background: #f7f9fa; border-radius: 12rpx; padding: 20rpx; text-align: center; }
.stat-num { display: block; font-size: 44rpx; font-weight: 800; color: #0d9f6d; }
.stat-label { display: block; font-size: 22rpx; color: #5c6b74; margin-top: 4rpx; }

.panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.panel-meta { font-size: 24rpx; color: #5c6b74; }
.todo-form { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.todo-input { flex: 1; background: #f7f9fa; border: 1px solid #dfe5e8; border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
.add-btn { width: 80rpx; height: 80rpx; background: #0d9f6d; color: #fff; border-radius: 12rpx; font-size: 40rpx; line-height: 80rpx; text-align: center; padding: 0; }
.filter-row { margin-bottom: 12rpx; }
.seg { display: flex; background: #f7f9fa; border-radius: 12rpx; padding: 4rpx; }
.seg-item { flex: 1; text-align: center; padding: 10rpx 0; font-size: 26rpx; color: #5c6b74; border-radius: 10rpx; }
.seg-item.active { background: #fff; color: #0d9f6d; font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
.todo-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1px solid #eef1f3; }
.todo-item.done .todo-text { text-decoration: line-through; color: #9aa9a4; }
.todo-check { width: 44rpx; height: 44rpx; border: 2rpx solid #c5ced4; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 28rpx; color: transparent; flex: none; }
.todo-check.checked { background: #0d9f6d; border-color: #0d9f6d; color: #fff; }
.todo-text { flex: 1; font-size: 28rpx; word-break: break-all; }
.todo-del { color: #c5ced4; padding: 8rpx; font-size: 28rpx; }
.todo-foot { display: flex; justify-content: space-between; margin-top: 16rpx; }
.todo-foot-count { font-size: 24rpx; color: #5c6b74; }
.clear-btn { font-size: 24rpx; color: #e05f3a; }
.name-edit-hint { font-size: 22rpx; color: #c5ced4; margin-left: 8rpx; font-weight: 400; }
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 90; display: flex; align-items: center; justify-content: center; }
.modal-card { width: 560rpx; background: #fff; border-radius: 20rpx; padding: 40rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; text-align: center; }
.modal-input { border: 1px solid #dfe5e8; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.modal-btn { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; font-size: 28rpx; }
.modal-btn.cancel { background: #f2f4f5; color: #5c6b74; }
.modal-btn.ok { background: #0d9f6d; color: #fff; font-weight: 600; }
.modal-tip { font-size: 22rpx; color: #9aa9a4; margin-top: 16rpx; text-align: center; }

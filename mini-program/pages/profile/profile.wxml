<view class="page {{themeClass}} {{colorClass}}">
  <!-- 我的 -->
  <view class="section-title">我的</view>
  <view class="panel">
    <view class="setting-item">
      <view class="setting-left"><text class="setting-icon">👤</text><text class="setting-name">账号</text></view>
      <view class="setting-right"><text class="setting-value">{{nickname || '已登录'}}</text><text class="setting-arrow">›</text></view>
    </view>
    <view class="setting-item" bindtap="goCountdown">
      <view class="setting-left"><text class="setting-icon">🎯</text><text class="setting-name">未来倒计时</text></view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="goStats">
      <view class="setting-left"><text class="setting-icon">📊</text><text class="setting-name">历史时间轴</text></view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onEditName">
      <view class="setting-left"><text class="setting-icon">✏️</text><text class="setting-name">修改昵称</text></view>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <!-- 外观 | 主题 -->
  <view class="section-title">外观 | 主题</view>
  <view class="panel">
    <view class="setting-item">
      <view class="setting-left"><text class="setting-icon">🌗</text><text class="setting-name">明暗主题</text><text class="setting-desc">浅色 / 深色</text></view>
      <text class="setting-value">{{themeLabel}}</text>
    </view>
    <view class="setting-block">
      <view class="setting-left"><text class="setting-icon">🎨</text><text class="setting-name">主题颜色搭配</text><text class="setting-desc">选择主色调</text></view>
      <view class="color-row">
        <view class="color-dot {{themeColor==='green'?'sel':''}}" data-color="green" bindtap="onColor" style="background:#0d9f6d;"></view>
        <view class="color-dot {{themeColor==='blue'?'sel':''}}" data-color="blue" bindtap="onColor" style="background:#3b6fd4;"></view>
        <view class="color-dot {{themeColor==='orange'?'sel':''}}" data-color="orange" bindtap="onColor" style="background:#e05f3a;"></view>
        <view class="color-dot {{themeColor==='purple'?'sel':''}}" data-color="purple" bindtap="onColor" style="background:#7c5cd6;"></view>
        <view class="color-dot {{themeColor==='pink'?'sel':''}}" data-color="pink" bindtap="onColor" style="background:#d6538c;"></view>
      </view>
    </view>
  </view>

  <!-- 专注计时 -->
  <view class="section-title">专注计时</view>
  <view class="panel">
    <view class="setting-item" bindtap="onEditMotto">
      <view class="setting-left"><text class="setting-icon">💬</text><text class="setting-name">自定义番茄钟格言</text></view>
      <view class="setting-right"><text class="setting-value">{{motto || '默认'}}</text><text class="setting-arrow">›</text></view>
    </view>
    <view class="setting-item" bindtap="goPomodoro">
      <view class="setting-left"><text class="setting-icon">⏱️</text><text class="setting-name">自定义休息时间</text></view>
      <text class="setting-value">{{restMin}} 分钟</text>
    </view>
    <view class="setting-item" bindtap="onToggleSound">
      <view class="setting-left"><text class="setting-icon">🔔</text><text class="setting-name">计时完成提示音</text></view>
      <switch checked="{{soundOn}}" color="#0d9f6d" bindchange="onToggleSound" />
    </view>
    <view class="setting-item" bindtap="onToggleMidnight">
      <view class="setting-left"><text class="setting-icon">🌙</text><text class="setting-name">午夜模式</text><text class="setting-desc">开启后,凌晨 0-4 点的专注计时将计入前一天(适合熬夜党)</text></view>
      <switch checked="{{midnightOn}}" color="#0d9f6d" bindchange="onToggleMidnight" />
    </view>
    <view class="setting-item" bindtap="onToggleFixedSort">
      <view class="setting-left"><text class="setting-icon">📌</text><text class="setting-name">固定排序</text><text class="setting-desc">开启后,已完成的待办保持原位,不会沉到列表底部</text></view>
      <switch checked="{{fixedSort}}" color="#0d9f6d" bindchange="onToggleFixedSort" />
    </view>
    <view class="setting-item" bindtap="onToggleDoneLine">
      <view class="setting-left"><text class="setting-icon">🚫</text><text class="setting-name">不在待办名称上划完成线</text><text class="setting-desc">开启后,已完成待办保留原文字样式,不加删除线(仅变灰保留可读性)</text></view>
      <switch checked="{{noDoneLine}}" color="#0d9f6d" bindchange="onToggleDoneLine" />
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>

  <!-- 格言弹窗 -->
  <view class="modal-mask" wx:if="{{showMotto}}" bindtap="closeMotto">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">番茄钟格言</view>
      <input class="modal-input" placeholder="写一句激励自己的话" maxlength="30" value="{{mottoInput}}" bindinput="onMottoInput" />
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeMotto">取消</view>
        <view class="modal-btn ok" bindtap="saveMotto">保存</view>
      </view>
    </view>
  </view>

  <!-- 昵称弹窗 -->
  <view class="modal-mask" wx:if="{{showNameModal}}" bindtap="onNameCancel">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">设置昵称</view>
      <input class="modal-input" placeholder="输入昵称(1-24位)" maxlength="24" value="{{nameInput}}" bindinput="onNameInput" />
      <view class="modal-tip">支持中文、字母、数字、_ 和 -</view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="onNameCancel">取消</view>
        <view class="modal-btn ok" bindtap="onNameConfirm">保存</view>
      </view>
    </view>
  </view>
</view>
.page { padding-bottom: 140rpx; }
.empty-state { text-align: center; padding: 120rpx 60rpx; }
.empty-icon { display: block; font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { display: block; font-size: 32rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: var(--muted); line-height: 1.7; margin-bottom: 12rpx; }
.cd-list { padding: 0 24rpx; }
.cd-item { display: flex; justify-content: space-between; align-items: center; background: var(--panel); border: 1px solid var(--line); border-radius: 16rpx; padding: 24rpx; margin: 16rpx 0; }
.cd-title { display: block; font-size: 30rpx; font-weight: 600; color: var(--ink); }
.cd-date { display: block; font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.cd-right { display: flex; align-items: center; gap: 20rpx; }
.cd-days { font-size: 44rpx; font-weight: 800; color: var(--accent); }
.cd-days.urgent { color: var(--warm); }
.cd-unit { font-size: 22rpx; font-weight: 400; color: var(--muted); margin-left: 2rpx; }
.cd-del { font-size: 30rpx; color: var(--muted); padding: 8rpx; }
.fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 110rpx; height: 110rpx; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: 56rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2); z-index: 20; }
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 90; display: flex; align-items: center; justify-content: center; }
.modal-card { width: 600rpx; background: var(--panel); border-radius: 20rpx; padding: 40rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; text-align: center; color: var(--ink); }
.custom-field { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.custom-label { width: 140rpx; font-size: 28rpx; color: var(--ink); }
.custom-input { flex: 1; border: 1px solid var(--line); border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 28rpx; background: var(--soft); color: var(--ink); }
.date-chip { border: 1px solid var(--line); border-radius: 12rpx; padding: 14rpx 24rpx; font-size: 28rpx; color: var(--ink); background: var(--soft); }
.modal-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-btn { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; font-size: 28rpx; }
.modal-btn.cancel { background: var(--soft); color: var(--muted); }
.modal-btn.ok { background: var(--accent); color: var(--accent-ink); font-weight: 600; }

/* app.wxss — 全局样式 */
page {
  --accent: #0d9f6d;
  --accent-ink: #ffffff;
  --accent-soft: #e3f4ec;
  --warm: #e05f3a;
  --warm-soft: #fdeee7;
  --amber: #c9871c;
  --amber-soft: #fbf1dc;
  --blue: #3b6fd4;
  --blue-soft: #e7eefb;
  --ink: #1c242a;
  --muted: #5c6b74;
  --line: #dfe5e8;
  --bg: #f2f4f5;
  --panel: #ffffff;
  --shadow: 0 1px 2px rgba(20, 30, 35, 0.05);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 16rpx;
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0 0 16rpx;
}

.btn-primary {
  background: var(--accent);
  color: var(--accent-ink);
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-ghost {
  background: var(--panel);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.empty-hint {
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  padding: 40rpx 0;
}

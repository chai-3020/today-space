/* app.wxss - 全局样式 + 主题变量 */
.page {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

page {
  --bg: #f2f4f5;
  --panel: #ffffff;
  --ink: #1c242a;
  --muted: #5c6b74;
  --line: #dfe5e8;
  --soft: #f7f9fa;
  --accent: #0d9f6d;
  --accent-ink: #ffffff;
  --accent-soft: #e3f4ec;
  --warm: #e05f3a;
  --warm-soft: #fdeee7;
  --amber: #c9871c;
  --amber-soft: #fbf1dc;
  --blue: #3b6fd4;
  --blue-soft: #e7eefb;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

/* 深色主题(手动切换:根容器加 theme-dark 类) */
.page.theme-dark {
  --bg: #14181a;
  --panel: #1d2326;
  --ink: #edf2f0;
  --muted: #9aa9a4;
  --line: #2b3438;
  --soft: #222a2d;
  --accent: #3cd798;
  --accent-ink: #0b2b1e;
  --accent-soft: #17392e;
  --warm: #ff8a66;
  --warm-soft: #3b241d;
  --amber: #f0b64e;
  --amber-soft: #3a2f17;
  --blue: #7fa6f0;
  --blue-soft: #1e2c44;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 1px 2px rgba(20, 30, 35, 0.05);
  padding: 24rpx;
  margin: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0 0 16rpx;
  color: var(--ink);
}

.btn-primary {
  background: var(--accent);
  color: var(--accent-ink);
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-ghost {
  background: var(--panel);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.empty-hint {
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  padding: 40rpx 0;
}